# Copy this file to .env and fill in the keys you use. Never commit .env.
#
# Providers come from the old chat-ui config files in ./providers. For each
# file, <NAME>_API_KEY here overrides the apiKey written inside the file.

# Free options (sign up, create a key, paste it here):
#   Groq        https://console.groq.com/keys
#   Gemini      https://aistudio.google.com/apikey
#   OpenRouter  https://openrouter.ai/settings/keys
#   Ollama      no key needed: install from https://ollama.com, then `ollama pull llama3.2`
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Paid providers
# Hive (DeepSeek V4.1 Flash): dashboard > Service API Keys > Create API Key, copy the Secret Key
HIVE_API_KEY=
DEEPSEEK_API_KEY=
CHATGPT_API_KEY=
CHATGPTPROXY_API_KEY=
DEEPINFRA_API_KEY=
ALI_QWEN_API_KEY=
NVIDIANIM_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Which provider the app starts with (file name without .json, or "claude").
# If unset: the first of Claude, Groq, Gemini, OpenRouter, DeepSeek that has a key.
# DEFAULT_PROVIDER=deepseek

# PORT=8000
